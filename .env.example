# ---------------------------------------------------------------------------
# HappyMed Pharmacy IMS - environment
# Copy to .env and fill in. Never commit .env.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Supabase
# ---------------------------------------------------------------------------
# Both URLs come from: Supabase Dashboard -> Connect
# They differ ONLY in host and port. Same database, same password.
#
# DATABASE_URL      = Transaction pooler, port 6543. Used by the running app.
#                     Serverless functions open and drop connections constantly;
#                     going straight to Postgres exhausts its connection limit.
#
# DIRECT_DATABASE_URL = Session pooler or Direct connection, port 5432. Used by
#                     `prisma migrate` ONLY. Transaction-mode pooling breaks DDL
#                     and the advisory locks migrations depend on, so schema
#                     changes must never go through port 6543.
#
# If the direct connection refuses to connect, use the Session pooler instead:
# direct connections are IPv6-only on Supabase unless you have the IPv4 add-on.

DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?uselibpqcompat=true&sslmode=require"
DIRECT_DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?uselibpqcompat=true&sslmode=require"

# Scratch database for `prisma migrate dev` to diff against.
# Leave empty until you have a second Supabase project to use as shadow; see
# the "Shadow database" note in README.md.
SHADOW_DATABASE_URL=""

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# How long a sign-in stays valid before re-authentication. Days.
SESSION_TTL_DAYS=7

# Public URL of the app, used in emails and redirects.
APP_URL="http://localhost:3000"

# Shared secret for the nightly job at /api/cron/daily. Without it the endpoint
# refuses every request, so the auto-quarantine will not run.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
CRON_SECRET=""

# ---------------------------------------------------------------------------
# Seed credentials for the first owner account.
# Change SEED_OWNER_PASSWORD before seeding anything you will actually use.
# ---------------------------------------------------------------------------
SEED_OWNER_EMAIL="owner@happymed.local"
SEED_OWNER_PASSWORD="ChangeMeNow!2026"
SEED_OWNER_NAME="Pharmacy Owner"

# ---------------------------------------------------------------------------
# Email (optional). Without both of these the daily digest is built and logged
# but not delivered; every other part of the nightly job still runs.
# ---------------------------------------------------------------------------
RESEND_API_KEY=""
DIGEST_FROM_EMAIL="alerts@yourdomain.com"
